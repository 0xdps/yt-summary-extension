    "eventsource-parser": "^3.0.6",
    "expiry-map": "^2.0.0",
    "gb-url": "^1.1.6",
    "github-markdown-css": "^5.7.0",
    "gpt3-tokenizer": "^1.1.5",
    "inter-ui": "^4.1.1",
    "jquery": "^3.7.1",
    "lodash-es": "^4.17.21",
    "preact": "^10.26.1",
    "prop-types": "^15.8.1",
    "punycode": "^2.3.1",
    "react": "npm:@preact/compat@^17.1.2",
    "react-dom": "npm:@preact/compat@^17.1.2",
    "react-markdown": "^8.0.7",
